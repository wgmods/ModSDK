(def element Hub2DBannerActiveState (_bannerSide:str='', _unifiedStatus:str='', _rewardAvailableText:str='', _rewardClaimedText:str='',
									_statusText:str='', _amountAvailable:number=0, _amountNeeded:number=0, _amountText:str='',
									_progress:number=-1, _progressBarText:str='', _currencyIconUrl:str='')
	(scope
		(var amountText:str = "_amountText ? _amountText : 'IDS_2D_HUB_AMOUNT_TEXT_BANNER_STATUS'")
		(var align:number = "_bannerSide == SC.Hub_2d.BANNER_SIDE.SIDE	? center
																		: left")
		(var unifiedStatusText:str = "	_unifiedStatus == SC.Ui_styles.UNIFIED_STATUS.REWARD_AVAILABLE	? _rewardAvailableText	? _rewardAvailableText
																																: 'IDS_2D_HUB_REWARD_AVAILABLE_BANNER_STATUS' :
										_unifiedStatus == SC.Ui_styles.UNIFIED_STATUS.CHECK				? _rewardClaimedText	? _rewardClaimedText
																																: 'IDS_2D_HUB_GIFT_RECEIVED_BANNER_STATUS'
																										: ''")

		(var byteArrayCollection:gfx = "$datahub.getCollection(CC.byteArrayData)")
		(var currencyIconByteArrayEntity:gfx = "$datahub.getPrimaryEntity(CC.byteArrayData, _currencyIconUrl)" (event "byteArrayCollection.evAdded"))
		(var currencyIconByteArrayComponent:gfx = "currencyIconByteArrayEntity ? currencyIconByteArrayEntity.byteArrayData : null")
		(var byteArrayData:gfx = "currencyIconByteArrayComponent ? currencyIconByteArrayComponent.data : null" (event "currencyIconByteArrayComponent.evUpdate"))
	)

	(style (width = 100%))

	
	(block
		(bind visible "unifiedStatusText")
		(style
			(width = 100%)
			(marginBottom = "SXS")
			(bind align "align")
		)

		(element StatusLine
			_text = "unifiedStatusText"
			_unifiedStatus = "_unifiedStatus"
			_leading = 0
		)
	)

	
	(block
		(bind visible "_statusText")
		(style 
			(width = 100%)
			(marginBottom = "SXS")
			(bind align "align")
		)

		(element StatusLine
			_text = "_statusText"
		)
	)

	
	(block
		(bind visible "_amountAvailable")
		(style (width = 100%) (marginBottom = "SXS"))

		(element Hub2DBannerAmountAvailable
			_text = "subst(amountText, [], {_amount: _amountAvailable})"

			(style (bind align "align"))
		)
	)

	
	(block
		(bind visible "_amountNeeded")
		(style (width = 100%) (marginBottom = "S"))

		(element Hub2DBannerAmountNeeded
			_amount = "_amountNeeded"
			_text = "_progressBarText ? _progressBarText : 'IDS_2D_HUB_AMOUNT_PROGRESS_BAR_BANNER_STATUS'"
			_currencyIcon = "byteArrayData"

			(style (bind align "align"))
		)
	)

	
	(block
		(bind visible "_progress >= 0")
		(style (width = 100%) (marginBottom = "SXS"))

		(element DefaultProgressBar
			_progress = "_progress"
			_height = "6"
		)
	)
)

(def element Hub2DBannerInactiveState (_bannerSide:str='', _level:number=0, _unifiedStatus:str='',
										_timeLeftToStart:number=0, _formattedTimeLeftToStart:str='', _timeLeftToFinish:number=0)
	(scope
		(var unifiedStatusText:str = "	_unifiedStatus == SC.Ui_styles.UNIFIED_STATUS.DATE && _timeLeftToFinish > 0	? 'IDS_2D_HUB_AVAILABLE_TIME_END_BANNER_STATUS' :
										_unifiedStatus == SC.Ui_styles.UNIFIED_STATUS.LOCK							? subst('IDS_REACH_ACCESS_LEVEL', [], {_level: _level}) :
										_unifiedStatus == SC.Ui_styles.UNIFIED_STATUS.DATE && _timeLeftToStart > 0	? subst('IDS_2D_HUB_START_TIME_BANNER_STATUS', [], {_timeLeftToStart: _formattedTimeLeftToStart}) :
										_unifiedStatus == SC.Ui_styles.UNIFIED_STATUS.NEGATIVE						? 'IDS_2D_HUB_SERVICE_NOT_AVAILABLE_BANNER_STATUS'
																													: ''")
	)
	(style (width = 100%))

	
	(block
		(bind visible "unifiedStatusText")
		(style
			(width = 100%)
			(marginBottom = "SXS")
			(bind align "_bannerSide == SC.Hub_2d.BANNER_SIDE.SIDE  ? center
																	: left")
		)

		(controller $Instance renderer='StatusLine'
			(args
				_text = "unifiedStatusText"
				_unifiedStatus = "_unifiedStatus"
				_leading = 0
			)
		)
	)
)