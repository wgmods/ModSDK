(def constant ACCOUNT_LEVELLING {
	BATTLE_CARD: {
		WIDTH: 300px,
		HEIGHT: 490px,

		BACKGROUND_ALPHA_DEFAULT: 0.2,
		BACKGROUND_ALPHA_TARGET: 0.45,

		BORDER_ALPHA_DEFAULT: 0.2,
		BORDER_ALPHA_TARGET: 0.4,

		ICON_WIDTH: 164px,
		ICON_HEIGHT: 164px,

		CONTENT_WIDTH: 264px
	},
	BATTLE_CARD_BULLET: {
		ICON_WIDTH: 24px,
		ICON_HEIGHT: 24px,

		TEXT_WIDTH: 240px
	},
	NEW_LEVEL_ITEM: {
		ICON_WIDTH: 256px,
		ICON_HEIGHT: 256px
	}
})

(def element BattleTypeCard (	_featureIndex:number=0, _iconFeaturePath:str='', _title:str='',
								_subtitle:str='', _descriptions:array=[], _isShowCardText:bool=false) layout=true
	(scope
		(macro MOUSE_HANDLER_SCOPE)

		(var cardBackgroundImage:str = "'url:../accountLevel/bg/bg_' + _featureIndex + '.png'")
		(var cardIcon:str = "'url:' + _iconFeaturePath + '.png'")
		(var descriptionsCount:number = "_descriptions ? _descriptions.length : 0")
		(var hoverProgress:number = 0)

		(var backgroundAlphaDefault:number = "ACCOUNT_LEVELLING.BATTLE_CARD.BACKGROUND_ALPHA_DEFAULT")
		(var backgroundAlphaTarget:number = "ACCOUNT_LEVELLING.BATTLE_CARD.BACKGROUND_ALPHA_TARGET")
		(var backgroundAlpha:number = "backgroundAlphaTarget * hoverProgress + backgroundAlphaDefault * (1 - hoverProgress)")

		(var borderAlphaDefault:number = "ACCOUNT_LEVELLING.BATTLE_CARD.BORDER_ALPHA_DEFAULT")
		(var borderAlphaTarget:number = "ACCOUNT_LEVELLING.BATTLE_CARD.BORDER_ALPHA_TARGET")
		(var borderAlpha:number = "borderAlphaTarget * hoverProgress + borderAlphaDefault * (1 - hoverProgress)")

		(controller $Animation
			(bindcall play
				duration = 0.5
				to = "{hoverProgress: 1}"
				easing = "Easing.quad_out"
				watch = false

				(event "evRollOver")
			)

			(bindcall play
				duration = 0.5
				to = "{hoverProgress: 0}"
				easing = "Easing.quad_out"
				watch = false

				(event "evRollOut")
			)
		)
	)

	(style
		(width = "ACCOUNT_LEVELLING.BATTLE_CARD.WIDTH")
		(height = "ACCOUNT_LEVELLING.BATTLE_CARD.HEIGHT")

		(bind backgroundImage "cardBackgroundImage")
	)

	(block
		(class $FullsizeAbsolute)

		(style
			(hitTest = false)
			(backgroundColor = 0xFF000000)
			(bind alpha "backgroundAlpha")
		)
	)

	(element OnePixelFrameBorder _alpha = "borderAlpha")

	(block
		(class $FullsizeAbsolute)

		(style
			(align = "center|middle")
			(marginTop = -9px)
		)

		(block
			(style
				(width = 100%)
				(align = "center")
			)

			
			(block
				(style
					(width = "ACCOUNT_LEVELLING.BATTLE_CARD.ICON_WIDTH")
					(height = "ACCOUNT_LEVELLING.BATTLE_CARD.ICON_HEIGHT")
					(backgroundSize = "cover")
					(align = "center")

					(bind backgroundImage "cardIcon")
				)
			)

			
			(block
				(controller $Animation
					(bindcall play
						duration = 0.3
						delay = 0
						from = "{top: 10, alpha: 0}"
						to = "{top: 0, alpha: 1}"
						easing = "Easing.quad_out"
						action = "kill"
						watch = false

						(bind trigger "_isShowCardText")
					)
				)

				(style
					(width = "ACCOUNT_LEVELLING.BATTLE_CARD.CONTENT_WIDTH")
					(alpha = 0)
					(align = "center")
					(marginTop = -3px)
				)

				(tf
					(class $TextDefaultBold21NM)

					(style
						(width = 100%)
						(alpha = "TA")
						(textAlign = "center")
					)

					(bind text "_title")
				)
			)

			
			(block
				(controller $Animation
					(bindcall play
						duration = 0.3
						delay = 0.15
						from = "{top: 10, alpha: 0}"
						to = "{top: 0, alpha: 1}"
						easing = "Easing.quad_out"
						action = "kill"
						watch = false
						(bind trigger "_isShowCardText")
					)
				)

				(style
					(width = "ACCOUNT_LEVELLING.BATTLE_CARD.CONTENT_WIDTH")
					(alpha = 0)
					(align = "center")

					(bind marginTop "12 * (1 - hoverProgress)")
					(bind ubScaleY "1 - hoverProgress")
				)

				(tf
					(class $TextDefaultBoldNM)

					(style
						(width = 100%)
						(alpha = "TC")
						(textAlign = "center")

						(bind alpha "TC * (1 - hoverProgress)")
					)

					(bind text "tr('IDS_CARD_SUBTITLE_' + _featureIndex)")
				)
			)

			
			(element BattleTypeCardDescription
				_featureIndex = "_featureIndex"
				_hoverProgress = "hoverProgress"
			)
		)
	)

	(macro MOUSE_HANDLER
		_dispatchedEv = "'evCardClicked'"
	)
)

(def element BattleTypeCardDescription (_featureIndex:number, _hoverProgress:number) layout=true
	(block
		(style
			(width = "ACCOUNT_LEVELLING.BATTLE_CARD.CONTENT_WIDTH")
			(align = "center")

			(bind marginTop "10 * _hoverProgress")
			(bind ubScaleY "_hoverProgress")
			(bind alpha "_hoverProgress")
		)

		(block
			(style
				(width = 100%)
				(align = "center")
				(marginTop = 8px)
				(marginBottom = 8px)
			)

			(element BattleTypeCardBullet
				_text = "'IDS_CARD_DESCRIPTION_' + _featureIndex"
				_iconPath = 'url:../accountLevel/icons/icon_main.png'
				_isLast = false
			)

			(element BattleTypeCardBullet
				_text = "'IDS_CARD_GOAL_' + _featureIndex"
				_iconPath = 'url:../accountLevel/icons/icon_main.png'
				_isLast = true
			)
		)

		(block
			(class $FullsizeAbsolute)
			(isMask = true)
			(style
				(backgroundColor = 0xFFFFFFFF)
			)
		)
	)
)

(def element BattleTypeCardBullet (_text:str='', _iconPath:str='', _isLast:bool=false) layout=true
	(style
		(width = 100%)
		(bind marginBottom "_isLast ? 0 : 14")
	)

	(block
		(style
			(width = 100%)
			(flow = "horizontal")
		)

		(block
			(style
				(alpha = 0.8)
				(width = "ACCOUNT_LEVELLING.BATTLE_CARD_BULLET.ICON_WIDTH")
				(height = "ACCOUNT_LEVELLING.BATTLE_CARD_BULLET.ICON_HEIGHT")
				(marginTop = -6px)
				(backgroundSize = "cover")

				(bind backgroundImage "_iconPath")
			)
		)

		(tf
			(class $TextDefaultNM)

			(style
				(alpha = "TA")
				(width = "ACCOUNT_LEVELLING.BATTLE_CARD_BULLET.TEXT_WIDTH")
			)

			(bind text "_text")
		)
	)
)

(def element IconAccountLevelUpItem (_iconFeaturePath:str='') layout=true
	(style
		(width = "ACCOUNT_LEVELLING.NEW_LEVEL_ITEM.ICON_WIDTH")
		(height = "ACCOUNT_LEVELLING.NEW_LEVEL_ITEM.ICON_HEIGHT")
		(backgroundSize = "cover")

		(bind backgroundImage "'url:' + _iconFeaturePath + '_big.png'")
	)
)
