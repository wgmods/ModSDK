
(def macro BANNER_CONTENT_SCOPE (_bannerEntity:expression)
	(macro MOUSE_HANDLER_SCOPE)

	
	(var blockDataComponent:gfx = "_bannerEntity ? _bannerEntity.hub2DBannerBlockData : null" (event "_bannerEntity.evAdded") (event "_bannerEntity.evRemoved"))
	(var levelBlockerNumber:number = "blockDataComponent ? blockDataComponent.levelBlockerNumber : null" (event "blockDataComponent.evChanged"))
	(var isBlockedByLevel:bool = "blockDataComponent ? blockDataComponent.isBlockedByLevel : false" (event "blockDataComponent.evChanged"))
	(var isBlockedByTime:bool = "blockDataComponent ? blockDataComponent.isBlockedByTime : false" (event "blockDataComponent.evChanged"))
	(var isBlockedByDependency:bool = "blockDataComponent ? blockDataComponent.isBlockedByDependency : false" (event "blockDataComponent.evChanged"))
	(var dateBlockerStartsAt:number = "blockDataComponent ? blockDataComponent.dateBlockerStartsAt : null" (event "blockDataComponent.evChanged"))
	(var dateBlockerEndsAt:number = "blockDataComponent ? blockDataComponent.dateBlockerEndsAt : null" (event "blockDataComponent.evChanged"))

	(macro SERVER_TIME_SCOPE)
	(var timeLeftToStart:number = "dateBlockerStartsAt - serverTime")
	(var timeLeftToFinish:number = "serverTime - dateBlockerEndsAt")
	(macro COUNTDOWN_SCOPE "'formattedTimeLeftToStart'" "dateBlockerStartsAt" "'HIGHESTDAYS'")
	(macro COUNTDOWN_SCOPE "'formattedTimeLeftToFinish'" "dateBlockerEndsAt" "'HIGHESTDAYS'")

	
	(var contentDataComponent:gfx = "_bannerEntity ? _bannerEntity.hub2DBannerContentData : null" (event "_bannerEntity.evAdded") (event "_bannerEntity.evRemoved"))
	(var titleLocalizationIDS:str = "contentDataComponent ? contentDataComponent.titleLocalizationIDS : null" (event "contentDataComponent.evChanged"))
	(var descriptionLocalizationIDS:str = "contentDataComponent ? contentDataComponent.descriptionLocalizationIDS : null" (event "contentDataComponent.evChanged"))
	(var statusLocalizationIDS:str = "contentDataComponent ? contentDataComponent.statusLocalizationIDS : null" (event "contentDataComponent.evChanged"))
	(var mouseInstructionIDS:str = "contentDataComponent ? contentDataComponent.mouseInstructionIDS : null" (event "contentDataComponent.evChanged"))
	(var imageUrl:str = "contentDataComponent ? contentDataComponent.imageUrl : null" (event "contentDataComponent.evChanged"))
	(var expImageUrl:str = "contentDataComponent ? contentDataComponent.expImageUrl : null" (event "contentDataComponent.evChanged"))

	
	(var rewardDataComponent:gfx = "_bannerEntity ? _bannerEntity.hub2DBannerRewardData : null" (event "_bannerEntity.evAdded") (event "_bannerEntity.evRemoved"))
	(var hasReward:bool = "rewardDataComponent ? rewardDataComponent.hasReward : null" (event "rewardDataComponent.evChanged"))
	(var rewardAvailableLocalizationIDS:str = "rewardDataComponent ? rewardDataComponent.rewardAvailableLocalizationIDS : ''" (event "rewardDataComponent.evChanged"))
	(var rewardClaimedLocalizationIDS:str = "rewardDataComponent ? rewardDataComponent.rewardClaimedLocalizationIDS : ''" (event "rewardDataComponent.evChanged"))

	
	(var unifiedStatusDataComponent:gfx = "_bannerEntity ? _bannerEntity.hub2DBannerUnifiedStatusData : null" (event "_bannerEntity.evAdded") (event "_bannerEntity.evRemoved"))
	(var unifiedStatus:str = "unifiedStatusDataComponent ? unifiedStatusDataComponent.unifiedStatus : null" (event "unifiedStatusDataComponent.evChanged"))

	
	(var progressDataComponent:gfx = "_bannerEntity ? _bannerEntity.hub2DBannerProgressData : null" (event "_bannerEntity.evAdded") (event "_bannerEntity.evRemoved"))
	(var barProgress:number = "progressDataComponent ? progressDataComponent.barProgress : -1" (event "progressDataComponent.evChanged"))
	(var progressBarLocalizationIDS:str = "progressDataComponent ? progressDataComponent.progressLocalizationIDS : null" (event "progressDataComponent.evChanged"))
	(var currentValue:number = "progressDataComponent ? progressDataComponent.currentValue : 0" (event "progressDataComponent.evChanged"))
	(var maxValue:number = "progressDataComponent ? progressDataComponent.thresholdValue : 0" (event "progressDataComponent.evChanged"))
	(var amountAvailable:number = "progressDataComponent ? progressDataComponent.availableValue : null" (event "progressDataComponent.evChanged"))
	(var amountNeeded:number = "progressDataComponent ? progressDataComponent.neededValue : null" (event "progressDataComponent.evChanged"))
	(var amountLocalizationIDS:str = "progressDataComponent ? progressDataComponent.amountLocalizationIDS : null" (event "progressDataComponent.evChanged"))

	
	(var baseDataComponent:gfx = "_bannerEntity ? _bannerEntity.hub2DBannerBaseData : null" (event "_bannerEntity.evAdded") (event "_bannerEntity.evRemoved"))
	(var hubId:str = "baseDataComponent ? baseDataComponent.hub2dId : null" (event "baseDataComponent.evChanged"))
	(var bannerId:str = "baseDataComponent ? baseDataComponent.id : null" (event "baseDataComponent.evChanged"))
	(var bannerType:number = "baseDataComponent ? baseDataComponent.bannerType : -1" (event "baseDataComponent.evChanged"))
	(var sectionType:str = "baseDataComponent ? baseDataComponent.sectionType : null" (event "baseDataComponent.evChanged"))

	
	(var hasNewItem:bool = "_bannerEntity ? _bannerEntity.hasComponent(CC.newItem) : false"	(event "_bannerEntity.evAdded")
																							(event "_bannerEntity.evRemoved"))

	
	(var tooltipRenderer:str = "baseDataComponent ? baseDataComponent.tooltipRenderer : ''" (event "baseDataComponent.evChanged"))

	
	(var battleDataComponent:gfx = "_bannerEntity ? _bannerEntity.hub2DBannerBattleData : null" (event "_bannerEntity.evAdded") (event "_bannerEntity.evRemoved"))
	(var currentBattleEntityId:number = "battleDataComponent ? battleDataComponent.currentBattleEntityId : null" (event "battleDataComponent.evChanged"))

	
	(var tokenDataComponent:gfx = "_bannerEntity ? _bannerEntity.hub2DBannerTokenData : null" (event "_bannerEntity.evAdded") (event "_bannerEntity.evRemoved"))
	(var isTokenReceived:bool = "tokenDataComponent ? tokenDataComponent.isTokenReceived : false" (event "tokenDataComponent.evChanged"))
	(var isUIInteractionDisabled:bool = "tokenDataComponent ? tokenDataComponent.isUIInteractionDisabled : false" (event "tokenDataComponent.evChanged"))

	(var isActive:bool = "!(isBlockedByLevel || isBlockedByTime || isBlockedByDependency)")
	(var bannerUnifiedStatus:str = "isBlockedByTime && timeLeftToFinish > 0	? SC.Ui_styles.UNIFIED_STATUS.DATE :
									isBlockedByLevel						? SC.Ui_styles.UNIFIED_STATUS.LOCK :
									isBlockedByTime && timeLeftToStart > 0	? SC.Ui_styles.UNIFIED_STATUS.DATE :
									isBlockedByDependency					? SC.Ui_styles.UNIFIED_STATUS.NEGATIVE :
									hasReward								? SC.Ui_styles.UNIFIED_STATUS.REWARD_AVAILABLE :
									isTokenReceived							? SC.Ui_styles.UNIFIED_STATUS.CHECK
																			: SC.Ui_styles.UNIFIED_STATUS.DEFAULT")
)

(def element Hub2DpromotedBannerContent (_bannerEntity:gfx=null)
	(scope
		(macro BLUR_MAP_SCOPE) 
		(macro BANNER_CONTENT_SCOPE "_bannerEntity")
		(macro GET_PREF 'isUIContrastOptionEnabled' "'graphics.GUI.contrast'")
		(var isHighContrast:bool = "isUIContrastOptionEnabled || !isBlurOptionEnabled")
	)

	(class $FullsizeAbsolute)
	(bind colorTransform "	isActive && rollOver && !isUIInteractionDisabled	? ITEM_OVER_COLOR_TRANSFORM_PARAMS
																				: {}")

	
	(block
		(style
			(width = 100%)
			(height = 100%)
			(bind alpha "!isActive ? 0.4 : 1")
			(macro DESATURATION_DEFAULT "isActive")
		)

		(element Hub2DBannerItemIcon
			_bannerSide = "SC.Hub_2d.BANNER_SIDE.PROMOTED"
			_imageUrl = "imageUrl"
		)
	)

	
	(block

		(style
			(position = "absolute")
			(width = 100%)
			(bottom = 0)
			(hitTest = false)
			(backgroundColor = 0xB3000700)
		)

		(block
			(bind visible "!isHighContrast")
			(class $FullsizeAbsolute)
			(element DeclareBlurLayer)
			(element BlurMap)
		)

		(block
			(style (width = 100%) (padding = [16px, 16px, 36px, 4px]))
			(block
				(style (width = 100%))
				(element Hub2DBannerItemTitle
					_bannerSide = "SC.Hub_2d.BANNER_SIDE.PROMOTED"
					_title = "titleLocalizationIDS"
					_unifiedStatus = "bannerUnifiedStatus"
					_isNew = "hasNewItem"
				)
			)

			
			(block
				(bind visible "isActive")
				(style (width = 100%) (paddingTop = "SXS"))

				(element Hub2DBannerActiveState
					_bannerSide = "SC.Hub_2d.BANNER_SIDE.PROMOTED"
					_unifiedStatus = "bannerUnifiedStatus"
					_statusText = "statusLocalizationIDS"
					_amountAvailable = "amountAvailable"
					_amountNeeded = "amountNeeded"
					_amountText = "amountLocalizationIDS"
					_progress = "barProgress"
					_progressBarText = "progressBarLocalizationIDS"
					_currencyIconUrl = "expImageUrl"
					_rewardAvailableText = "rewardAvailableLocalizationIDS"
					_rewardClaimedText = "rewardClaimedLocalizationIDS"
				)
			)

			
			(block
				(bind visible "!isActive")
				(style (width = 100%) (paddingTop = "SXS"))

				(element Hub2DBannerInactiveState
					_bannerSide = "SC.Hub_2d.BANNER_SIDE.PROMOTED"
					_unifiedStatus = "bannerUnifiedStatus"
					_level = "levelBlockerNumber"
					_timeLeftToStart = "timeLeftToStart"
					_formattedTimeLeftToStart = "formattedTimeLeftToStart"
					_timeLeftToFinish = "timeLeftToFinish"
				)
			)
		)
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(bind alpha "!isActive								? 0.1 :
						 rollOver && !isUIInteractionDisabled	? 0.3
																: 0.2")
			(backgroundImage = "'url:../service_kit/frames/one_pixel_frame.png'")
			(scale9grid=2)
			(hitTest=false)
		)
	)
	(macro HUB2D_BANNER_TOOLTIP)

	(macro MOUSE_HANDLER
		_soundSet = "isActive && !isUIInteractionDisabled ? 'button_2D_Hub_Banner_Main' : ''"
	)
)

(def element Hub2DsideBannerContent (_bannerEntity:gfx=null)
	(scope
		(macro BANNER_CONTENT_SCOPE "_bannerEntity")
	)

	(class $FullsizeAbsolute)
	(style
		(bind backgroundColor "!isActive								? HUB2D_BACKGROUNDCOLOR_INACTIVE :
								rollOver && !isUIInteractionDisabled	? HUB2D_BACKGROUNDCOLOR_ROLLOVER
																		: HUB2D_BACKGROUNDCOLOR_ACTIVE")
	)
	(bind colorTransform "isActive && rollOver && !isUIInteractionDisabled	? ITEM_OVER_COLOR_TRANSFORM_PARAMS
																			: {}")

	(block
		(class $Fullsize)
		(style
			(align = "center|middle")
			(padding = "L")
		)

		
		(block
			(style
				(marginBottom = "M")
				(bind alpha "!isActive ? 0.4 : 1")
			)

			(element Hub2DBannerItemIcon
				_bannerSide = "SC.Hub_2d.BANNER_SIDE.SIDE"
				_imageUrl = "imageUrl"
			)
		)

		
		(block
			(style (width = 100%) (marginBottom = "M"))
			(element Hub2DBannerItemTitle
				_bannerSide = "SC.Hub_2d.BANNER_SIDE.SIDE"
				_title = "titleLocalizationIDS"
				_unifiedStatus = "bannerUnifiedStatus"
				_isNew = "hasNewItem"
			)
		)

		
		(block
			(bind visible "isActive")
			(style (width = 100%))

			(element Hub2DBannerActiveState
				_bannerSide = "SC.Hub_2d.BANNER_SIDE.SIDE"
				_unifiedStatus = "bannerUnifiedStatus"
				_statusText = "statusLocalizationIDS"
				_amountAvailable = "amountAvailable"
				_amountNeeded = "amountNeeded"
				_amountText = "amountLocalizationIDS"
				_progress = "barProgress"
				_progressBarText = "progressBarLocalizationIDS"
				_currencyIconUrl = "expImageUrl"
				_rewardAvailableText = "rewardAvailableLocalizationIDS"
				_rewardClaimedText = "rewardClaimedLocalizationIDS"
			)
		)

		
		(block
			(bind visible "!isActive")
			(style (width = 100%))

			(element Hub2DBannerInactiveState
				_bannerSide = "SC.Hub_2d.BANNER_SIDE.SIDE"
				_unifiedStatus = "bannerUnifiedStatus"
				_level = "levelBlockerNumber"
				_timeLeftToStart = "timeLeftToStart"
				_formattedTimeLeftToStart = "formattedTimeLeftToStart"
				_timeLeftToFinish = "timeLeftToFinish"
			)
		)
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(bind alpha "!isActive								? 0.1 :
						 rollOver && !isUIInteractionDisabled	? 0.3
																: 0.2")
			(backgroundImage = "'url:../service_kit/frames/one_pixel_frame.png'")
			(scale9grid=2)
			(hitTest=false)
		)
	)
	(macro HUB2D_BANNER_TOOLTIP)

	(macro MOUSE_HANDLER
		_soundSet = "isActive && !isUIInteractionDisabled ? 'button_2D_Hub_Banner_Side' : ''"
	)
)

(def element Hub2DinfoBannerContent(_bannerEntity:gfx=null)
	(scope
		(macro BANNER_CONTENT_SCOPE "_bannerEntity")
	)
	(class $FullsizeAbsolute)

	(style
		(align = "middle")
		(flow = "horizontal")
		(bind backgroundColor "!isActive								? HUB2D_BACKGROUNDCOLOR_INACTIVE :
								rollOver && !isUIInteractionDisabled	? HUB2D_BACKGROUNDCOLOR_ROLLOVER
																		: HUB2D_BACKGROUNDCOLOR_ACTIVE")
	)

	(hblock
		(style
			(width = 100%)
			(align = "middle")
			(gap = "XS")
			(paddingLeft = "SXS")
			(paddingRight = "LS")
		)

		
		(block
			(controller $Instance renderer='Hub2DBannerStatusIcon'
				(bind enabled "bannerUnifiedStatus != SC.Ui_styles.UNIFIED_STATUS.DEFAULT")
				(args
					_unifiedStatus = "bannerUnifiedStatus"
				)
			)
		)

		
		(element Hub2DBannerItemTitle
			_class = '$TextDefaultBoldNM'
			_title = "titleLocalizationIDS"
			_unifiedStatus = "bannerUnifiedStatus"
			_isNew = "hasNewItem"
		)
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(bind alpha "!isActive								? 0.1 :
						 rollOver && !isUIInteractionDisabled	? 0.3
																: 0.2")
			(backgroundImage = "'url:../service_kit/frames/one_pixel_frame.png'")
			(scale9grid=2)
			(hitTest=false)
		)
	)

	(macro HUB2D_BANNER_TOOLTIP)

	(macro MOUSE_HANDLER
		_soundSet = "isActive && !isUIInteractionDisabled ? 'button_2D_Hub_Banner_Inititives' : ''"
	)
)

(def element Hub2DnewsBannerContent(_bannerEntity:gfx=null)
	(scope
		(macro BANNER_CONTENT_SCOPE "_bannerEntity")
		(macro GET_UNREAD_NEW_COUNTER_AND_GIFT_STATUS_SCOPE) 
		(var isAllNewsBanner:bool = "bannerType == SC.Hub_2d.BANNER_TYPE.ALL_NEWS")
		(var isRecommendedNewsVisible:bool = "isAllNewsBanner && isActive && isUnreadRecommendedNews && !hasReward")
		(var isStatusIconVisible:bool = "bannerUnifiedStatus != SC.Ui_styles.UNIFIED_STATUS.REWARD_AVAILABLE && bannerUnifiedStatus != SC.Ui_styles.UNIFIED_STATUS.DEFAULT")
	)
	(class $FullsizeAbsolute)

	(style
		(align = "middle")
		(bind backgroundColor "!isActive								? HUB2D_BACKGROUNDCOLOR_INACTIVE :
								rollOver && !isUIInteractionDisabled	? HUB2D_BACKGROUNDCOLOR_ROLLOVER
																		: HUB2D_BACKGROUNDCOLOR_ACTIVE")
	)

	(hblock
		(style
			(width = 100%)
			(align = "middle")
			(gap = "XS")
			(paddingLeft = "SXS")
		)

		
		(block
			(controller $Instance renderer='Hub2DBannerStatusIcon'
				(bind enabled "isStatusIconVisible")
				(args
					_unifiedStatus = "bannerUnifiedStatus"
				)
			)
		)

		
		(element Hub2DBannerItemTitle
			_class = '$TextDefaultBold21NM'
			_title = "titleLocalizationIDS"
			_unifiedStatus = "bannerUnifiedStatus"
			_isNew = "hasNewItem"
		)
	)

	
	(block
		(bind visible "bannerUnifiedStatus == SC.Ui_styles.UNIFIED_STATUS.REWARD_AVAILABLE")
		(style
			(position = "absolute") (right = "S") (top = "S")
			(width = "L") (height = "L")
			(bind backgroundImage "'url:../service_kit/port_banner/icon_banner_reward.png'")
		)
	)

	
	(block
		(bind visible "isRecommendedNewsVisible")
		(style
			(position = "absolute") (right = "SXS") (top = "M")
		)
		(tf
			(class $TextDefaultBold21NM)
			(style
				(alpha = "TA")
			)
			(bind text "unreadRecommendedNewsCount")
		)
	)

	(block
		(class $FullsizeAbsolute)

		(style
			(bind alpha "!isActive								? 0.1 :
						 rollOver && !isUIInteractionDisabled	? 0.3
																: 0.2")
			(backgroundImage = "'url:../service_kit/frames/one_pixel_frame.png'")
			(scale9grid=2)
			(hitTest=false)
		)
	)

	(macro HUB2D_BANNER_TOOLTIP)

	(macro MOUSE_HANDLER
		_soundSet = "isActive && !isUIInteractionDisabled ? 'button_2D_Hub_Banner_News' : ''"
	)
)



(def macro HUB2D_BANNER_TOOLTIP ()
	(controller $Tooltip
		(bind enabled "tooltipRenderer != ''")
		(bind renderer "!isActive	? SC.Hub_2d.BANNER_TOOLTIP_RENDERER.BASE : tooltipRenderer")
		(args
			_isActive = "isActive"
			_headerText = "titleLocalizationIDS"
			_descriptionText = "descriptionLocalizationIDS"
			_statusText = "statusLocalizationIDS"
			_unifiedStatus = "bannerUnifiedStatus"
			_rewardAvailableText = "rewardAvailableLocalizationIDS"
			_rewardClaimedText = "rewardClaimedLocalizationIDS"
			_amountAvailable = "amountAvailable"
			_amountNeeded = "amountNeeded"
			_amountText = "amountLocalizationIDS"
			_progress = "barProgress"
			_progressBarText = "progressBarLocalizationIDS"
			_currentValue = "currentValue"
			_maxValue = "maxValue"
			_timeLeftToStart = "timeLeftToStart"
			_formattedTimeLeftToStart = "formattedTimeLeftToStart"
			_timeLeftToFinish = "timeLeftToFinish"
			_formattedTimeLeftToFinish = "formattedTimeLeftToFinish"
			_mouseInstructionText = "mouseInstructionIDS"
			_level = "levelBlockerNumber"
			_battleTypeEntityId = "currentBattleEntityId"
			_isUIInteractionDisabled = "isUIInteractionDisabled"
			_isShowUB2Tooltip = "true"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR "0")
		(bindcall externalCall 'inputMapping.onAction' "['onTooltipShow', {hubId: hubId, bannerId: bannerId}]" init=false watch=false on='evStartShow')
		(bindcall externalCall 'inputMapping.onAction' "['onTooltipHide', {hubId: hubId, bannerId: bannerId}]" init=false watch=false on='evStartHide')
	)
)

(def element Hub2DBannerItemIcon (_imageUrl:str, _bannerSide:str='')
	(scope
		(var byteArrayCollection:gfx = "$datahub.getCollection(CC.byteArrayData)")
		(var byteArrayEntity:gfx = "$datahub.getPrimaryEntity(CC.byteArrayData, _imageUrl)" (event "byteArrayCollection.evAdded"))
		(var byteArrayComponent:gfx = "byteArrayEntity ? byteArrayEntity.byteArrayData : null")
	)

	(style
		(bind width "_bannerSide == SC.Hub_2d.BANNER_SIDE.SIDE	? 80
																: 100%")
		(bind height "_bannerSide == SC.Hub_2d.BANNER_SIDE.SIDE	? 80
																: 100%")
		(bind backgroundImage "byteArrayComponent && byteArrayComponent.data	? byteArrayComponent.data
																				: ''")
		(backgroundSize = "fill")
	)
)

(def element Hub2DBannerStatusIcon (_unifiedStatus:str='')
	(style
		(width = 19px) (height = 19px)
		(backgroundSize = "cover")
		(bind backgroundImage "'url:../service_kit/unified_status_icons/icon_' + _unifiedStatus + '.png'")
	)
)

(def element Hub2DBannerItemTitle ( _title:str='', _class:str='', _unifiedStatus:str="SC.Ui_styles.UNIFIED_STATUS.DEFAULT",
									_bannerSide:str='', _isNew:bool=false)
	(style
		(width = 100%)
		(bind align "_bannerSide == SC.Hub_2d.BANNER_SIDE.SIDE ? center : left")
		(flow = "horizontal")
	)

	(macro UNIFIED_STATUS_TO_COLOR_AND_ALPHA "_unifiedStatus" "'textColor'" "'textAlpha'")

	(block
		(bind visible "_bannerSide == SC.Hub_2d.BANNER_SIDE.SIDE")
		(style
			(width = "L")
			(marginRight = "S")
		)
	)

	(tf
		(bind class "_class ? _class : '$TextDefaultBold19NM'")
		(bind alpha "textAlpha")

		(style
			(maxWidth = 100%)
			(bind textColor "textColor")
			(bind textAlign "_bannerSide == SC.Hub_2d.BANNER_SIDE.SIDE ? center : left")
		)

		(bind text "_title")
	)

	(block
		(bind alpha "_isNew ? 1 : 0")
		(style
			(marginLeft = 4px)
			(marginTop = -10px)
		)

		(macro DEFAULT_CONTROL_MARKER_ANIMATION "_isNew")
		(element MarkerNew)
	)
)

(def element Hub2DBannerItemDescription (_bannerSide:str='', _descriptionText:str='', _textColor:str=null)
	(style
		(width = 100%)
		(bind align "_bannerSide == SC.Hub_2d.BANNER_SIDE.SIDE	? center
																: left")
	)

	(tf
		(class $TextDefaultNM)
		(style
			(width = 100%)
			(textColor = "_textColor ? _textColor : SC.Ui_styles.SERVICE_COLORS.WHITE")
			(alpha = "TA")
		)

		(bind text "_descriptionText")
	)
)

(def element Hub2DBannerAmountAvailable (_text:str='', _textClass:str='$TextDefaultNM')
	(style 
		(width = 100%)
	)

	(tf
		(style
			(alpha = "TA")
		)
		(bind class "_textClass")

		(bind text "_text")
	)
)

(def element Hub2DBannerAmountNeeded (_amount:number=0, _text:str='', _currencyIcon:gfx=null, _textClass:str='$TextDefaultNM')
	(style 
		(width = 100%)
	)

	(hblock
		(style (align = "middle"))

		(tf
			(style
				(marginRight = "6px")
				(alpha = "TC")
			)
			(bind class "_textClass")

			(bind text "_text")
		)

		(tf
			(style
				(alpha = "TA")
			)
			(bind class "_textClass")

			(bind text "_amount")
		)

		(block
			(style
				(width = "M")
				(height = "M")
				(marginLeft = "XS")
				(bind backgroundImage "_currencyIcon ? _currencyIcon : 'url:../service_kit/currencies/icon_exp_small.png'")
			)
		)
	)
)