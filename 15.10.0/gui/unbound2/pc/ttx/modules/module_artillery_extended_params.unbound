(def element AmmoHEDamageNoDiff (shipTTX:gfx, ammoHETTX:gfx) layout=true
	(style (width = 100%))
	(element ShipParameter_Number	_title = 'IDS_SHIP_PARAM_DAMAGE_HE'
									_value = "ammoHETTX.damage"
									_showDelta = false
									_hideDiff = true
									_zeroValueHidden = true
	)
)

