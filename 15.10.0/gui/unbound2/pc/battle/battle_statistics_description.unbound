

(def constant BATTLE_STATISTICS_INFO_PANEL_PADDING 16)
(def constant BATTLE_STATISTICS_INFO_PANEL_COLOR 0x50000000)

(def constant BATTLE_STATISTICS_LOADING_COLUMN_WIDTH 450)
(def constant BATTLE_STATISTICS_LOADING_COLUMN_WIDTH_PVE 389)




(def constant BATTLE_STATISTICS_TAB_COLUMN_WIDTH "{1280: 400, 1920: 450}")
(def constant BATTLE_STATISTICS_TAB_TASKS_WIDTH 392)



(def constant BATTLE_STATISTICS_TAB_PANEL_GAP "{1280: 10, 1920: 70}")			
(def constant BATTLE_STATISTICS_TAB_PANEL_GAP_PVE "{1280: 23, 1920: 23}")		
(def constant BATTLE_STATISTICS_LOADING_PANEL_GAP "{1280: 176, 1920: 176}")		
(def constant BATTLE_STATISTICS_LOADING_PANEL_GAP_PVE "{1280: 71, 1920: 71}")	

(def constant BATTLE_STATISTICS_TASK_ICON_SIZE 27px)






(def constant BATTLE_STATISTICS_SCROLLBAR_GUTTER 18)














(def macro BATTLE_STATISTICS_SCROLL_COLUMN_SHELL (_widthHD:expression, _widthFHD:expression, _height:expression, _flush:expression="false")
	(style
		(bind width "{	1280: (_widthHD) + TEAM_ROW_MUTE_ICONS_GUTTER + BATTLE_STATISTICS_SCROLLBAR_GUTTER,
						1920: (_widthFHD) + TEAM_ROW_MUTE_ICONS_GUTTER + BATTLE_STATISTICS_SCROLLBAR_GUTTER}")
		(marginLeft = "(_flush) ? -TEAM_ROW_MUTE_ICONS_GUTTER : BATTLE_STATISTICS_SCROLLBAR_GUTTER - TEAM_ROW_MUTE_ICONS_GUTTER")
		(marginRight = "(_flush) ? -BATTLE_STATISTICS_SCROLLBAR_GUTTER : 0")
		(bind height "_height")
		(backgroundColor = 0x01000000)
	)

	(verticalSlider = 'ScrollBarVLight')
	(topShadow = 'ScrollAreaShadowTop')
	(bottomShadow = 'ScrollAreaShadowBottom')

	(hscrollPolicy = 'off')
	(vscrollPolicy = 'auto')
)


(def macro BATTLE_STATISTICS_SCROLL_COLUMN_CONTENT (_widthHD:expression, _widthFHD:expression)
	(style
		(bind width "{	1280: (_widthHD) + TEAM_ROW_MUTE_ICONS_GUTTER,
						1920: (_widthFHD) + TEAM_ROW_MUTE_ICONS_GUTTER}")
		(paddingLeft = "TEAM_ROW_MUTE_ICONS_GUTTER")
	)
)



(def macro BATTLE_STATISTICS_TOOLTIP_BEHAVIOUR (_event:expression)
	(align = "bottom|center")
	(position = "border")
	(offset = [0, 6])
	(screenBoundsOffset = {left: 10, top: 10, right: 10, bottom: 10})
	(cache = false)
	(macro SIMPLE_TOOLTIP_ANIMATION)
	(macro BATTLE_STATS_LOG_TOOLTIP_DURATION "_event")
)


(def element BattleStatisticsHeader (battleInfo:gfx)
	(scope
		
		(var gameModeId:number = "battleInfo.gameModeId" (event "battleInfo.evGameModeIdChanged"))
		(var scenario:str = "battleInfo.scenario")
		(var mapName:str = "battleInfo.mapName")
		(var gameMode:str = "battleInfo.gameMode")
		(var battleType:str = "battleInfo.battleType")
	)
	(style
		(width = 100%)
		(align = "center")
	)
	(tf
		(name = 'mapName')
		(class $TextDefaultBold21NM)
		(style
			(marginTop = "MS")
			(marginBottom = 16px)
		)
		(alpha = "TA")
		(bind text "gameModeId == SC.Battle.GAME_MODE.PVE ? tr('IDS_' + toUpper(scenario) + '_NAME') : toUpper(tr(mapName))")
	)
	(element HorizontalDividerTwoPx)

	(tf
		(name = 'battleType')
		(class $TextDefaultNM)
		(style
			(marginTop = "SXS")
			(marginBottom = "SXS")
		)
		(alpha = "TA")
		(bind text "gameModeId == SC.Battle.GAME_MODE.PVE
			? tr('IDS_' + toUpper(gameMode) + '_TITLE')
			: tr('IDS_' + toUpper(gameMode) + '_TITLE') + ' — ' + tr('IDS_' + toUpper(battleType))")
	)
	(element HorizontalDividerTwoPx)
)





(def element BattleStatisticsInfoPanel (
	_leftRenderer:str,
	_rightRenderer:str,
	_gap:dict,
	_rightShown:bool=true) layout=true
	(style
		(width = 100%)
		(padding = "BATTLE_STATISTICS_INFO_PANEL_PADDING")
		(backgroundColor = "BATTLE_STATISTICS_INFO_PANEL_COLOR")
	)

	(hblock
		(style (width = 100%))

		
		
		
		
		(block
			(controller $Instance layout=true
				(bind renderer "_leftRenderer")
			)
		)
		
		(block
			(bind visible "_rightShown")
			(style (bind marginLeft "_gap"))
			(controller $Instance layout=true
				(bind renderer "_rightRenderer")
				(bind enabled "_rightShown")
			)
		)
	)
)


(def element BattleStatisticsTabRandomDescription () layout=true
	
	(name = 'battleStatisticsDescription')
	(scope
		
		
		(var battleDataEntity:gfx = "$datahub.getSingleEntity(CC.battleData)")
		(var battleInfo:gfx = "battleDataEntity ? battleDataEntity.battleInfo : null")
		(var gameModeDescription:str = "battleInfo ? battleInfo.gameModeDescription : ''")
	)
	(style
		(width = "BATTLE_STATISTICS_TAB_COLUMN_WIDTH")
		(gap = "MS")
	)

	(element BattleStatisticsDescriptionSection
		_title = "tr('IDS_PVE_OPERATION_GOAL')"
		_description = "gameModeDescription"
	)
	(element BattleStatisticsMechanicsList)
)

(def element BattleStatisticsTabOperationDescription () layout=true
	(name = 'battleStatisticsDescription')
	(scope
		(var battleDataEntity:gfx = "$datahub.getSingleEntity(CC.battleData)")
		(var battleInfo:gfx = "battleDataEntity ? battleDataEntity.battleInfo : null")
		(var scenario:str = "battleInfo ? battleInfo.scenario : ''")
	)
	(style
		(width = "BATTLE_STATISTICS_LOADING_COLUMN_WIDTH_PVE")
		(gap = "MS")
	)

	
	(element BattleStatisticsDescriptionSection
		_title = "tr('IDS_PVE_OPERATION_GOAL')"
		_description = "tr('IDS_' + toUpper(scenario) + '_GOAL')"
	)
	(element BattleStatisticsMechanicsList)
)


(def element BattleStatisticsTabPointsAccrual () layout=true
	(scope
		(event evBattleStatisticsPointsDetails)

		
		
		
		(var gameStatsCommandEntity:gfx = "$datahub.getPrimaryEntity(CC.commandMappingCommandName, 'CMD_GAME_STATS')")
		(var isStatsShown:bool = "gameStatsCommandEntity ? gameStatsCommandEntity.commandMappingCommand.isDown : false" (event "gameStatsCommandEntity.commandMappingCommand.evIsDownChanged"))

		(var rewardsCollection:gfx = "$datahub.getCollection(CC.winPointsRewardForDestroyingEnemyShip)")
		(var penaltiesCollection:gfx = "$datahub.getCollection(CC.winPointsPenaltyForDestroyingAllyShip)")
		(var holdingCollection:gfx = "$datahub.getCollection(CC.holdingPointsMessage)")
		(var rewards:gfx = "rewardsCollection ? rewardsCollection.getChildByPath('sorted') : null")
		(var penalties:gfx = "penaltiesCollection ? penaltiesCollection.getChildByPath('sorted') : null")
		(var holding:gfx = "holdingCollection ? holdingCollection.getChildByPath('sorted') : null")
		(bind rewards "rewardsCollection ? rewardsCollection.getChildByPath('sorted') : null" init=false watch=false (bind enabled "isStatsShown"))
		(bind penalties "penaltiesCollection ? penaltiesCollection.getChildByPath('sorted') : null" init=false watch=false (bind enabled "isStatsShown"))
		(bind holding "holdingCollection ? holdingCollection.getChildByPath('sorted') : null" init=false watch=false (bind enabled "isStatsShown"))
		(var rewardItems:array = "rewards ? rewards.items : []" (event "rewards.evAdded") (event "rewards.evRemoved"))
		(var penaltyItems:array = "penalties ? penalties.items : []" (event "penalties.evAdded") (event "penalties.evRemoved"))
		(var holdingItems:array = "holding ? holding.items : []" (event "holding.evAdded") (event "holding.evRemoved"))
		(var upgrades:gfx = "$datahub.getCollection(CC.upgradeCapturePoints)")
		(var upgradeItems:array = "upgrades ? upgrades.items : []" (event "upgrades.evAdded") (event "upgrades.evRemoved"))
	)
	(style
		(width = "BATTLE_STATISTICS_TAB_COLUMN_WIDTH")
		(gap = "S")
	)

	(bindcall externalCall 'inputMapping.onAction'
		"['battleStatisticsOpenPointsDetails', {}]"
		init=false watch=false (event "evBattleStatisticsPointsDetails"))

	(element BattleStatisticsMechanicDescription
		_title = "tr('IDS_BATTLE_STATISTICS_POINTS_TITLE')"
		_description = "tr('IDS_BATTLE_STATISTICS_POINTS_DESCRIPTION')"
		_detailsLabel = "tr('IDS_BATTLE_STATISTICS_TAB_DETAILED')"
		_detailsEvent = 'evBattleStatisticsPointsDetails'
		_detailsName = 'pointsDetailsButton'
	)

	(controller $Repeat layout=true
		(renderer = 'BattleStatisticsHoldingReward')
		(bind count "holdingItems.length")
		(args _entity = "holdingItems[$index]")
	)
	(controller $Repeat layout=true
		(renderer = 'BattleStatisticsUpgradeCaptureRow')
		(bind count "upgradeItems.length")
		(args _entity = "upgradeItems[$index]")
	)
	(element BattleStatisticsClassPointsRow
		_penaltyItems = "penaltyItems"
		_rewardItems = "rewardItems"
	)
)



(def element BattleStatisticsLoadingRandomDescription () layout=true
	
	(name = 'battleStatisticsDescription')
	(scope
		(event evBattleStatisticsPointsDetails)

		(var battleDataEntity:gfx = "$datahub.getSingleEntity(CC.battleData)")
		(var battleInfo:gfx = "battleDataEntity.battleInfo")
		(var gameModeDescription:str = "battleInfo.gameModeDescription")
		(var gameModeId:number = "battleInfo.gameModeId" (event "battleInfo.evGameModeIdChanged"))
		(var isPointsAccrualShown:bool = "!isIn(gameModeId, [SC.Battle.GAME_MODE.EPICENTER, SC.Battle.GAME_MODE.EPICENTER_RING, SC.Battle.GAME_MODE.CONVOY_AIRSHIP])")
	)
	(style
		(width = "BATTLE_STATISTICS_LOADING_COLUMN_WIDTH")
		(gap = "MS")
	)

	(bindcall externalCall 'inputMapping.onAction'
		"['battleStatisticsOpenPointsDetails', {}]"
		init=false watch=false (event "evBattleStatisticsPointsDetails"))

	(element BattleStatisticsDescriptionSection
		_title = "tr('IDS_PVE_OPERATION_GOAL')"
		_description = "gameModeDescription"
	)
	
	(block
		(bind visible "isPointsAccrualShown")
		(style (width = 100%))
		(element BattleStatisticsMechanicDescription
			_title = "tr('IDS_BATTLE_STATISTICS_POINTS_TITLE')"
			_description = "tr('IDS_BATTLE_STATISTICS_POINTS_DESCRIPTION')"
			_detailsLabel = "tr('IDS_BATTLE_STATISTICS_TAB_DETAILED')"
			_detailsEvent = 'evBattleStatisticsPointsDetails'
			_detailsName = 'pointsDetailsButton'
		)
	)
	(element BattleStatisticsMechanicsList
		_showInfographics = false
		_showDescriptionItems = false
	)
)

(def element BattleStatisticsLoadingOperationDescription () layout=true
	(name = 'battleStatisticsDescription')
	(scope
		(var battleDataEntity:gfx = "$datahub.getSingleEntity(CC.battleData)")
		(var battleInfo:gfx = "battleDataEntity.battleInfo")
		(var scenario:str = "battleInfo.scenario")
