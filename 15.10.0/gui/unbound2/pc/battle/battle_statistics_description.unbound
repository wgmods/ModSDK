	)
)

(def element BattleStatisticsDescriptionSection (_title:str, _description:str) layout=true
	(style
		(width = 100%)
		(gap = 16px)
	)

	(tf
		(class $TextDefaultBold19NM)
		(style
			(width = 100%)
			(alpha = "TA")
		)
		(bind text "_title")
	)
	(tf
		(class $TextDefaultNM)
		(style
			(width = 100%)
			(leading = -2px)
			(alpha = 0.7)
		)
		(bind text "_description")
	)
)






(def constant BATTLE_STATISTICS_BULLET_COLUMN_WIDTH 15)

(def element BattleStatisticsBulletList (_items:array) layout=true
	(style
		(width = 100%)
		(gap = "S")
	)

	(controller $Repeat renderer='BattleStatisticsBulletItem' layout=true
		(bind count "_items ? _items.length : 0")
		(args _text = "tr(_items[$index])")
	)
)

(def element BattleStatisticsBulletItem (_text:str) layout=true
	(style (width = 100%))

	(hblock
		(style (width = 100%))
		(tf
			(class $TextDefaultNM)
			(style
				(width = "BATTLE_STATISTICS_BULLET_COLUMN_WIDTH")
				(alpha = 0.7)
			)
			(text = '•')
		)
		(tf
			(class $TextDefaultNM)
			(style
				(width = 100%)
				(leading = -2px)
				(alpha = 0.7)
			)
			(bind text "_text")
		)
	)
)



(def element BattleStatisticsClassPointsRow (_penaltyItems:array, _rewardItems:array) layout=true
	(style
		(width = 100%)
		(flow = "horizontal")
		(gap = "S")
	)
	(controller $Repeat layout=true
		(renderer = 'BattleStatisticsShipPointsCell')
		(bind count "_penaltyItems.length")
		(args
			_entity = "_penaltyItems[$index]"
			_isPenalty = true
		)
	)
	(controller $Repeat layout=true
		(renderer = 'BattleStatisticsShipPointsCell')
		(bind count "_rewardItems.length")
		(args _entity = "_rewardItems[$index]")
	)
)


(def element BattleStatisticsShipPointsCell (_entity:gfx, _isPenalty:bool=false) layout=true
	(scope
		(var pointsComponent:gfx = "_isPenalty	? _entity.winPointsPenaltyForDestroyingAllyShip
												: _entity.winPointsRewardForDestroyingEnemyShip")
		(var shipType:str = "pointsComponent.shipType")
		(var points:number = "_isPenalty ? pointsComponent.penaltyPoints : pointsComponent.rewardPoints")
	)
	(style
		(width = 27px)
		(height = 38px)
		(align = "center")
	)
	(block
		(style
			(width = 27px)
			(height = 27px)
		)
		
		(block
			(style
				(position = "absolute")
				(left = 14px)
				(top = 15px)
				(width = 27px)
				(height = 27px)
			)
			(mc icon_ship_reward
				(bind visible "!_isPenalty")
				(class $MiddleAligned)
				(class $MiddleVAligned)
				(bindcall gotoAndStop "shipType" init=true)
			)
			(mc icon_ship_penalty
				(bind visible "_isPenalty")
				(class $MiddleAligned)
				(class $MiddleVAligned)
				(bindcall gotoAndStop "shipType" init=true)
			)
		)
	)
	
	(tf
		(class $TextDefaultBoldNM)
		(style
			(multiline = false)
			(alpha = 0.7)
		)
		(bind text "(_isPenalty ? '' : '+') + points")
	)

	
	(element HIT_TEST_TOOLTIP_CONTAINER
		(controller $Tooltip (renderer = 'BattleStatisticsPointsTooltip')
			(args
				_headerIDS = "(_isPenalty	? 'IDS_BATTLE_STATISTICS_TOOLTIP_DESTROY_ALLY_'
											: 'IDS_BATTLE_STATISTICS_TOOLTIP_DESTROY_ENEMY_') + toUpper(shipType)"
				_points = "points"
			)
			(macro BATTLE_STATISTICS_TOOLTIP_BEHAVIOUR "'ship_points_tooltip'")
		)
	)
)




(def element BattleStatisticsUpgradeCaptureRow (_entity:gfx) layout=true
	(scope
		(var upgrade:gfx = "_entity.upgradeCapturePoints")
		(var penaltyPoints:number = "upgrade.penaltyPoints")
		(var rewardPoints:number = "upgrade.rewardPoints")
	)
	(style
		(height = 27px)
		(flow = "horizontal")
		(align = "middle")
	)
	(block
		(style
			(width = 27px)
			(height = 27px)
			(backgroundSize = "fill")
			(backgroundImage = 'url:../battle_tasks/rules/icon_rules_gamemode_arms_race_1.png')
		)
	)
	(hblock
		(style
			(marginLeft = "S")
			(height = 27px)
			(align = "middle")
			(gap = "M")
		)
		(element BattleStatisticsUpgradeCaptureValue
			_labelIDS = 'IDS_ENEMY_TEAM'
			_headerIDS = 'IDS_BATTLE_STATISTICS_TOOLTIP_UPGRADE_CAPTURE_ENEMY'
			_points = "penaltyPoints"
		)
		(element BattleStatisticsUpgradeCaptureValue
			_labelIDS = 'IDS_ALLY_TEAM'
			_headerIDS = 'IDS_BATTLE_STATISTICS_TOOLTIP_UPGRADE_CAPTURE_ALLY'
			_points = "rewardPoints"
		)
	)
)

(def element BattleStatisticsUpgradeCaptureValue (_labelIDS:str, _headerIDS:str, _points:number) layout=true
	(style
		(height = 27px)
		(flow = "horizontal")
		(align = "middle")
		(gap = "S")
	)
	(tf
		(class $TextDefaultNM)
		(style
			(multiline = false)
			(alpha = 0.7)
		)
		(bind text "tr(_labelIDS)")
	)
	(tf
		(class $TextDefaultBoldNM)
		(style
			(multiline = false)
			(alpha = "TA")
		)
		(bind text "(_points < 0 ? '' : '+') + _points")
	)

	(element HIT_TEST_TOOLTIP_CONTAINER
		(controller $Tooltip (renderer = 'BattleStatisticsPointsTooltip')
			(args
				_headerIDS = "_headerIDS"
				_points = "_points"
			)
			(macro BATTLE_STATISTICS_TOOLTIP_BEHAVIOUR "'upgrade_capture_tooltip'")
		)
	)
)

(def element BattleStatisticsHoldingReward (_entity:gfx) layout=true
	(scope
		(var holding:gfx = "_entity.holdingPointsMessage")
		(var controlPointType:number = "holding.controlPointType")
		
		
		(var reward:gfx = "_entity.holdingPointsReward")
		(var rewardPoints:number = "reward ? reward.rewardPoints : 0")
		(var periodLabel:str = "reward ? reward.periodLabel : ''")
		(var periodMessage:str = "reward ? reward.periodMessage : ''")
		(var imagePath:str = "controlPointType == CapturePointType.BASE_WITH_POINTS
			? 'url:../battle_hud/briefing/holding_zones/flags.png'
			: controlPointType == CapturePointType.EPICENTER_CP
				? 'url:../battle_hud/briefing/holding_zones/epicenter_' + $index + '.png'
				: 'url:../battle_hud/briefing/holding_zones/letters.png'")
	)
	(style
		(height = 27px)
		(flow = "horizontal")
		(align = "middle")
	)
	(block
		(style
			(width = 27px)
			(height = 27px)
		)
		(block
			(style
				(position = "absolute")
				(left = -9px)
				(top = -9px)
				(width = 44px)
				(height = 44px)
				(backgroundSize = "fill")
				(bind backgroundImage "imagePath")
			)
			(bind visible "controlPointType != CapturePointType.BUILDING_CP")
		)
		(block
			(class $MiddleAligned)
			(class $MiddleVAligned)
			(bind visible "controlPointType == CapturePointType.BUILDING_CP")
			(mc icon_hold_fort_object)
		)
	)
	
	(hblock
		(style
			(marginLeft = "S")
			(height = 27px)
			(align = "middle")
		)
		(bind visible "rewardPoints != 0")

		(tf
			(class $TextDefaultNM)
			(style
				(multiline = false)
				(alpha = "TC")
			)
			(bind text "tr(controlPointType == CapturePointType.BASE_WITH_POINTS
				? 'IDS_HOLDING_BASE'
				: 'IDS_HOLDING_KEY_AREA')")
		)
		(tf
			(class $TextDefaultBoldNM)
			(style
				(multiline = false)
				(alpha = "TA")
				(marginRight = 6px)
			)
			(bind text "(rewardPoints < 0 ? '' : '+') + rewardPoints")
		)
		(tf
			(class $TextDefaultNM)
			(style
				(multiline = false)
				(alpha = "TC")
			)
			(bind text "periodMessage")
		)
	)

	(element HIT_TEST_TOOLTIP_CONTAINER
		(controller $Tooltip (renderer = 'BattleStatisticsPointsTooltip')
			(bind enabled "rewardPoints > 0")
			(args
				_headerIDS = "controlPointType == CapturePointType.BASE_WITH_POINTS
					? 'IDS_BATTLE_STATISTICS_TOOLTIP_HOLDING_BASE'
					: 'IDS_BATTLE_STATISTICS_TOOLTIP_HOLDING_CONTROL_POINT'"
				_points = "rewardPoints"
				_label = "periodLabel"
			)
			(macro BATTLE_STATISTICS_TOOLTIP_BEHAVIOUR "'holding_points_tooltip'")
		)
	)
)




(def element BattleStatisticsMechanicsList (_showInfographics:bool=true, _showDescriptionItems:bool=true) layout=true
	(scope
		
		
		(var gameStatsCommandEntity:gfx = "$datahub.getPrimaryEntity(CC.commandMappingCommandName, 'CMD_GAME_STATS')")
		(var isStatsShown:bool = "gameStatsCommandEntity ? gameStatsCommandEntity.commandMappingCommand.isDown : false" (event "gameStatsCommandEntity.commandMappingCommand.evIsDownChanged"))

		(var mechanicsCollection:gfx = "$datahub.getCollection(CC.battleMechanicDescription)")
		(var mechanics:gfx = "mechanicsCollection ? mechanicsCollection.getChildByPath('sorted') : null")
		(bind mechanics "mechanicsCollection ? mechanicsCollection.getChildByPath('sorted') : null" init=false watch=false (bind enabled "isStatsShown"))
		(var mechanicItems:array = "mechanics ? mechanics.items : []" (event "mechanics.evAdded") (event "mechanics.evRemoved"))
	)
	(style
		(width = 100%)
		(gap = "MS")
	)
	(controller $Repeat layout=true
		(renderer = 'BattleStatisticsMechanicBlock')
		(bind count "mechanicItems.length")
		(args
			_entity = "mechanicItems[$index]"
			_showInfographics = "_showInfographics"
			_showDescriptionItems = "_showDescriptionItems"
		)
	)
)

(def element BattleStatisticsMechanicBlock (_entity:gfx, _showInfographics:bool=true, _showDescriptionItems:bool=true) layout=true
	(scope
		(event evBattleStatisticsMechanicDetails)

		(var mech:gfx = "_entity.battleMechanicDescription")
		(var typeName:str = "SC.Battle.BATTLE_MECHANIC_TYPE.VALUE_TO_NAME[mech.mechanicType]")
		(var infographicItems:array = "mech.infographicItems ? mech.infographicItems : []")
		(var descriptionItems:array = "mech.descriptionItems ? mech.descriptionItems : []")
		
		
		(var descriptionIDS:str = "'IDS_BATTLE_MECHANIC_' + typeName + (descriptionItems.length > 0 && !_showDescriptionItems ? '_DESCRIPTION_SHORT' : '_DESCRIPTION')")
	)
	(style
		(width = 100%)
		(gap = "S")
	)

	
	
	(bindcall externalCall 'inputMapping.onAction'
		"['battleStatisticsOpenMechanicDetails', { mechanicType: mech.mechanicType }]"
		init=false watch=false (event "evBattleStatisticsMechanicDetails"))

	(element BattleStatisticsMechanicDescription
		_title = "tr('IDS_BATTLE_MECHANIC_' + typeName)"
		
		
		_description = "mech.textParams	? subst(descriptionIDS, [], mech.textParams)
										: tr(descriptionIDS)"
		_descriptionItems = "_showDescriptionItems ? descriptionItems : []"
		_detailsLabel = "tr('IDS_BATTLE_STATISTICS_TAB_DETAILED')"
		_detailsEvent = 'evBattleStatisticsMechanicDetails'
	)
	(controller $Instance renderer='BattleStatisticsMechanicInfographic' layout=true
		(bind enabled "_showInfographics && infographicItems.length > 0")
		(args _items = "infographicItems")
	)
)


(def element BattleStatisticsMechanicInfographic (_items:array) layout=true
	(style
		(flow = "horizontal")
		(gap = "S")
	)
	(controller $Repeat layout=true
		(renderer = 'BattleStatisticsMechanicInfographicIcon')
		(bind count "_items.length")
		(args
			_tooltipData = "_items[$index]"
			_iconPath = "'url:../powerups/drops/icon_marker_' + _items[$index].name + '.png'"
		)
	)
)

(def element BattleStatisticsMechanicInfographicIcon (_iconPath:str, _size:number=36, _tooltipData:dict="null") layout=true
	(style
		(bind width "_size")
		(bind height "_size")
		(backgroundSize = "fill")
		(bind backgroundImage "_iconPath")
	)

	(element HIT_TEST_TOOLTIP_CONTAINER
		
		(controller $Tooltip (renderer = 'BattleStatisticsBuffTooltip')
			(bind enabled "_tooltipData != null")
			(args
				_data = "_tooltipData"
			)
			(macro BATTLE_STATISTICS_TOOLTIP_BEHAVIOUR "'upgrade_drop_tooltip'")
		)
	)
)



(def element BattleStatisticsBuffTooltip (_data:dict) layout=true
	(style (width = 300) (hitTest = false))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = "_data.headerIDS"
		)
		(element TooltipSystemHorizontalDivider)
		(element TooltipSystemParamsModifiersList
			_attributesPositive = "_data.positive"
			_attributesNegative = "_data.negative"
			_attributesNeutral = "_data.neutral"
		)
	)
)



(def element BattleStatisticsPointsTooltip (_headerIDS:str, _points:number, _label:str='') layout=true
	(scope
		(var isPenalty:bool = "_points < 0")
		(var rows:array = "[{	attributeIDS: _label ? _label : 'IDS_BATTLE_STATISTICS_TOOLTIP_POINTS',
								measuredValue: (isPenalty ? '' : '+') + _points,
								measure: '',
								category: isPenalty ? 'negative' : 'positive' }]")
	)
	(style (width = 300) (hitTest = false))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = "_headerIDS"
		)
		(element TooltipSystemHorizontalDivider)
		(element TooltipSystemParamsModifiersList
			_attributesPositive = "isPenalty ? [] : rows"
			_attributesNegative = "isPenalty ? rows : []"
		)
	)
)

(def element BattleStatisticsMechanicDescription (
	_title:str,
	_description:str,
	_detailsLabel:str='',
	_detailsEvent:str='',
	
	
	_detailsName:str='mechanicDetailsButton',
	
	_descriptionItems:array=[]) layout=true
	(style
		(width = 100%)
		(gap = 16px)
	)

	(hblock
		(style
			(width = 100%)
			(height = 15px)
			(align = "middle")
		)
		
		
		(block
			(style
				(width = 100%)
				(paddingRight = 147px)
			)
			(tf
				(class $TextDefaultBold19NM)
				(style
					(width = 100%)
					(alpha = "TA")
				)
				(bind text "_title")
			)
		)
		(block
			(class $MiddleVAlignedAbsolutely)
			(style (right = 0))
			(controller $Instance renderer='DefaultButton'
				(bind enabled "_detailsLabel")
				(args
					_name = "_detailsName"
					_width = 94
					_size = "SIZE.SMALL"
					_type = "SC.Ui_styles.BUTTON_TYPE.SECONDARY"
					_label = "_detailsLabel"
					_dispatchedEv = "_detailsEvent"
				)
			)
		)
	)

	
	(block
		(style
			(width = 100%)
			(gap = "S")
		)
		(tf
			(class $TextDefaultNM)
			(style
				(width = 100%)
				(leading = 1px)
				(alpha = 0.7)
			)
			(bind text "_description")
		)
		(controller $Instance renderer='BattleStatisticsBulletList' layout=true
			(bind enabled "_descriptionItems.length > 0")
			(args _items = "_descriptionItems")
		)
	)
)
