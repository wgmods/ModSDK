(def css $PortBannerMargins ()
	(marginBottom  = "XS")
	(marginRight = "XS")
	(width = 240px)
)

(def css $PortBannerInnerMargins ()
	(width = 100%)
)

(def css $PortBannerStatusMargin ()
	(width = "L")
	(height = "L")
	(position = "absolute")
	(right = 0)
)

(def constant PORT_BANNER_WIDTH 240)
(def constant PORT_BANNER_SMALL_HEIGHT 36)
(def constant PORT_BANNER_LARGE_HEIGHT 100)

(def constant HUB2D_ENTER_BANNER_WIDTH 240)
(def constant HUB2D_ENTER_BANNER_LARGE_HEIGHT 100)
(def constant HUB2D_ENTER_BANNER_SMALL_HEIGHT 36)

(def element Banner2DHub (_isSmall:bool=false)
	(scope
		(macro MOUSE_HANDLER_SCOPE)
		(event evAddedToStage)

		
		(var visibleBannersCollection:gfx = "$datahub.getCollection(CC.hub2DBannerBlockData).getChildByPath('visibleBanners')")

		(var bannersWithRewardCollection:gfx = "visibleBannersCollection.getChildByPath('bannersWithReward')")
		(var hasBannersWithReward:bool = "bannersWithRewardCollection ? bannersWithRewardCollection.items.length > 0 : false"
			(event "bannersWithRewardCollection.evAdded")
			(event "bannersWithRewardCollection.evRemoved")
			(event "bannersWithRewardCollection.evChanged")
		)

		
		(var newContentEntity:gfx = "$datahub.getPrimaryEntity(CC.newContent, SC.Common.CONTENT_CATEGORY.HUB2D_BANNER)")
		(var newContentCounter:number = "newContentEntity ? newContentEntity.newContent.count : 0" (event "newContentEntity.newContent.evCountChanged"))
		(var hasNewData:bool = "newContentCounter > 0")

		
		(var hub2DWatcher:gfx = "$datahub.getFirstWatcher(CC.hub2D)")
		(var hub2DEntity:gfx = "hub2DWatcher ? hub2DWatcher.entity : null" (event "hub2DWatcher.event"))
		(var hub2DComponent:gfx = "hub2DEntity ? hub2DEntity.hub2D : null" (event "hub2DEntity.hub2D.evChanged"))

		(var entryPointImageUrl:str = "hub2DComponent ? hub2DComponent.entryPointImageUrl : ''" (event "hub2DComponent.evChanged"))
		(var entryPointRewardImageUrl:str = "hub2DComponent ? hub2DComponent.entryPointRewardImageUrl : ''" (event "hub2DComponent.evChanged"))
		(var entryPointCurrentImageUrl:str = "hasBannersWithReward ? entryPointRewardImageUrl : entryPointImageUrl" (event "hub2DComponent.evChanged"))

		(var byteArrayCollection:gfx = "$datahub.getCollection(CC.byteArrayData)")
		(var byteArrayEntity:gfx = "$datahub.getPrimaryEntity(CC.byteArrayData, entryPointCurrentImageUrl)" (event "byteArrayCollection.evAdded"))
		(var entryPointImageUrlByteArrayComponent:gfx = "byteArrayEntity ? byteArrayEntity.byteArrayData : null")

		(var bannerTitleText:str = "'IDS_DOCK_BANNER_2D_HUB'")
		(var containerImageName:str = "'port_banner' + (_isSmall ? '_small' : '') + (hasBannersWithReward ? '_reward': '')")
	)

	(bindcall externalCall "'inputMapping.onRequest'" "['show2DHub', {}]" init=false watch=false  on='click')

	(style
		(bind width "HUB2D_ENTER_BANNER_WIDTH")
		(bind height "_isSmall ? HUB2D_ENTER_BANNER_SMALL_HEIGHT : HUB2D_ENTER_BANNER_LARGE_HEIGHT")
		(padding = "XS")
		(backgroundSize = "cover")
		(bind backgroundImage "	entryPointImageUrlByteArrayComponent &&
								entryPointImageUrlByteArrayComponent.data	?	entryPointImageUrlByteArrayComponent.data
																			:	'url:../events/2d_hub/port/' + containerImageName + '.png'")
	)

	(controller $Animation
		(bindcall play  duration="0.15"
						delay="0.15"
						from = "{ alpha: 0, top: 5 }"
						to = "{ alpha: 1, top: 0 }"
						(event "evAddedToStage")
		)
	)

	(block
		(style
			(position = "absolute") (bottom = 0)
			(width = 100%) (height = 28px)
			(padding = "S")
		)

		(controller $Instance renderer='BannerItemTitle'
			(bind enabled "true")
			(args
				_title = "toUpper(tr(bannerTitleText))"
				_textColor = "hasBannersWithReward ? SC.Ui_styles.SERVICE_COLORS.YELLOW : SC.Ui_styles.SERVICE_COLORS.PAPER"
				_isNew = "hasNewData"
			)
		)
	)

	(macro PORT_BANNER_HOVER_STATE "rollOver")

	(macro MOUSE_HANDLER
		_soundSet = "'button_banner'"
	)

	(controller $Tooltip
		(bind renderer "'Banner2DHubTooltip'")
		(args
			_isRewardAvailable = "hasBannersWithReward"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR "0")
	)
)

(def element FlagshipPVEBanner (_operationEntityId:number)
	(scope
		(macro SIMPLE_MOUSE_OVER_DOWN_SELECTED_COLORTRANSFORM_SCOPE)
		(macro MOUSE_HANDLER_SCOPE)
		(var operationEntity:gfx="$datahub.getEntity(_operationEntityId)")
		(var bannerPath:str = "'url:../flagships_pve/port_banner/banner_flagships.png'")
	)

	(class $Fullsize)
	(style
		(align = "bottom")
		(width = 240px)
		(height = 60px)
	)

	(bindcall externalCall "'inputMapping.onRequest'" "['openGrandStrategyPassModal', {}]" init=false watch=false on='click')

	
	(block
		(bind visible "rollOver")

		(class $FullsizeAbsolute)
		(style (backgroundColor = "0x10FFFFFF"))
		
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(backgroundSize = "cover")
			(backgroundImage = "bannerPath")
		)
	)

	(block
		(style
			(width = 100%)
			(position = "absolute")
			(left = 12px)
			(bottom = 12px)
		)
		(controller $Instance renderer='BannerItemTitle'
			(bind enabled "true")
			(args
				_title = "toUpper(tr('IDS_FLAGSHIP_BANNER_TITLE'))"
				_textColor = "SC.Ui_styles.SERVICE_COLORS.PAPER"
			)
		)
	)
	(block
		(bind visible "rollOver")

		(class $FullsizeAbsolute)
		(style (backgroundColor = "0x10FFFFFF"))
		
	)

	(macro MOUSE_HANDLER
		_soundSet = "'button_banner'"
	)

	(controller $Tooltip
		(bind renderer "'FlagshipBannerTooltip'")
		(args
			_operationEntity = "operationEntity"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR "0")
	)
)

