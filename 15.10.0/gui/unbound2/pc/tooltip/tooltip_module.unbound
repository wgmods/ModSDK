(def element ModuleTooltip (_modulePK:str, _noMouseInstructions:bool=false, _isBermudaScreen:bool=false, _isShowUB2Tooltip:bool=false) layout=true dispatch_size_change=true
	(scope
		(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND_SCOPE)

		(var moduleEntity:gfx = "$datahub.getPrimaryEntity(CC.module, _modulePK)")
		(var moduleComponent:gfx = "moduleEntity.module" (event "moduleEntity.module.evUpdated"))
		(var moduleComponentId:number = "moduleComponent.id" (event "moduleComponent.evUpdated"))
		(var isEventModule:bool = "moduleEntity.hasComponent(CC.moduleExtendedInfo)")
		(var extendedInfoComponent:gfx = "isEventModule ? moduleEntity.moduleExtendedInfo : null" (event "moduleEntity.moduleExtendedInfo.evUpdated"))

		(var moduleType:str = "moduleComponent ? moduleComponent.type : ''" (event "moduleComponent.evUpdated"))
		(var moduleSubtype:str = "isEventModule && extendedInfoComponent.subtype != '' ? '_' + extendedInfoComponent.subtype : ''" (event "extendedInfoComponent.evUpdated"))
		(var ttxDescriptor:str = "isEventModule ? moduleType + moduleSubtype + '_extended' : moduleType")

		(var canBuy:bool = "moduleComponent ? moduleComponent.canBuy : false" (event "moduleComponent.evUpdated"))

		(var isExplored:bool = "moduleComponent ? moduleComponent.isExplored : false" (event "moduleComponent.evUpdated"))
		(var isPurchased:bool = "moduleComponent ? moduleComponent.isPurchased : false" (event "moduleComponent.evUpdated"))

		(var isExplorationLocked:bool = "!canBuy && !isPurchased")

		

		(var moduleBuyPricesEntity:gfx = "moduleComponentId ? $datahub.getPrimaryEntity(CC.prices, toString(moduleComponentId) + '_' + toString(SC.Common.PRICE_ACTION.BUY)) : null")
		(var moduleBuyPricesIds:array = "moduleBuyPricesEntity ? moduleBuyPricesEntity.prices.pricesInCurrencies : null" (event "moduleBuyPricesEntity.prices.evChanged"))
		(var moduleBuyPriceEntity:gfx =	"moduleBuyPricesIds ? $datahub.getEntity(toString(moduleBuyPricesIds[0])) : null")
		(var moduleBuyPriceInfo:gfx = "moduleBuyPriceEntity ? moduleBuyPriceEntity.itemPrice : null" (event "moduleBuyPriceEntity.itemPrice.evChanged"))

		(var moduleExplorePricesEntity:gfx = "moduleComponentId ? $datahub.getPrimaryEntity(CC.prices, toString(moduleComponentId) + '_' + toString(SC.Common.PRICE_ACTION.RESEARCH)) : null")
		(var moduleExplorePricesIds:array = "moduleExplorePricesEntity ? moduleExplorePricesEntity.prices.pricesInCurrencies : null" (event "moduleExplorePricesEntity.prices.evChanged"))
		(var moduleExplorePriceEntity:gfx =	"moduleExplorePricesIds ? $datahub.getEntity(toString(moduleExplorePricesIds[0])) : null")
		(var moduleExplorePriceInfo:gfx = "moduleExplorePriceEntity ? moduleExplorePriceEntity.itemPrice : null" (event "moduleExplorePriceEntity.itemPrice.evChanged"))

		(macro USER_PREF_DATA)
		(var isModulePreviewedInTTX:bool = "userPrefs.previewModuleId == moduleComponentId")

		(macro PULL_SHIP_ID)
		(macro PULL_SHIP_SCOPE "shipIdForModuleInset" "'shipEntity'" "'shipInfo'")
		(macro PULL_USI "shipEntity")

		(var ownShipWatcher:gfx = "$datahub.getPrimWatcher(CC.ownShip, shipIdForModuleInset)")
		(var ownShipEntity:gfx = "ownShipWatcher ? ownShipWatcher.entity : null" (event "ownShipWatcher.event"))
		(var ownShipComponent:gfx = "ownShipEntity ? ownShipEntity.ownShip : null")

		(var isLocked:bool = "ownShipComponent ? ownShipComponent.isLocked : false" (event "ownShipComponent.evUpdateLock"))
		(var isInFormation:bool = "ownShipComponent ? ownShipComponent.isInFormation : false" (event "ownShipComponent.evUpdateLock"))
		(var isNeedRepair:bool = "ownShipComponent ? ownShipComponent.isNeedRepair : false" (event "ownShipComponent.evUpdateDockState"))
		(var isNeedShell:bool = "ownShipComponent ? ownShipComponent.isNeedShell : false" (event "ownShipComponent.evUpdateDockState"))

		(var isOwned:bool = "ownShipEntity != null")
		(var isInstalled:bool = "moduleComponent ? moduleComponent.isInstalled : ''" (event "moduleComponent.evUpdated"))
		(var isStockModule:bool = "moduleComponent ? moduleComponent.isStock : ''" (event "moduleComponent.evUpdated"))

		(var headerIconPath:str = "	isEventModule ? 'url:../modules/event/' + moduleType + '/icon_module_' + moduleComponent.name + (isInstalled ? '_installed' : '') + '.png'
									: 'url:../modules/icon_module' +	moduleType +
																	(isInstalled && isOwned			? '_installed' :
																	isPurchased						? '' :
																	isExplored						? '_researched'
																									: '_not_owned') +
																	'.png'")

		(var unifiedStatus:str = "isInstalled ? SC.Ui_styles.UNIFIED_STATUS.CHECK : SC.Ui_styles.UNIFIED_STATUS.DEFAULT")
		(var headerText:str = "moduleComponent ? moduleComponent.nameText : ''" (event "moduleComponent.evUpdated"))
		(var subheaderText:str = "moduleComponent.subTypeIDS != '' ? moduleComponent.subTypeIDS : toUpper('IDS_MODULE_TYPE' + moduleType)" (event "moduleComponent.evUpdated"))
		(var isResearchPriceVisible:bool = "!isExplored && (!isStockModule || (isStockModule && upgradableShipInfo.isExplored)) && !isExplorationLocked && (moduleExplorePriceInfo.finalPrice > 0)")
		(var isBuyPriceVisible:bool = "!isPurchased && (!isStockModule || (isStockModule && isOwned)) && !isExplorationLocked && (moduleBuyPriceInfo.finalPrice > 0)")
		
		(var moduleStateInfo:dict = "	isExplorationLocked								? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.LOCK,
																							text: 'IDS_MODULE_STATE_CANNOT_BUY' } :
										isInstalled										? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.CHECK,
																							text: 'IDS_MODULE_STATE_INSTALLED' } :
										isPurchased										? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.INFO,
																							text: 'IDS_MODULE_STATE_AVAILABLE' } :
										isExplored && isBuyPriceVisible && !isOwned		? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.INFO,
																							text: 'IDS_MODULE_STATE_RESEARCHED_SHIP_NOT_OWNED' } :
										isExplored && isBuyPriceVisible					? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.INFO,
																							text: 'IDS_MODULE_STATE_RESEARCHED' } :
										isStockModule									? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.INFO,
																							text: 'IDS_STOCK_MODULE_INFO' }
																						: null")

		(var mouseInstruction:dict = "	_isBermudaScreen											? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT,
																										text: 'IDS_MOUSE_INSTRUCTION_SELECT_MODULE' } :
										_noMouseInstructions || isInstalled || isExplorationLocked	? null :
										isInFormation												? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.ATTENTION,
																										text: 'IDS_SET_UNREADY_DIVISION_FIRST_TO_MANAGE_SHIP' } :
										isLocked													? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.ATTENTION,
																										text: 'IDS_LEAVE_BATTLE_FIRST_TO_MANAGE_SHIP' } :
										isNeedRepair || isNeedShell									? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.ATTENTION,
																										text: 'IDS_SERVICE_SHIP_TO_MANAGE_SHIP' } :
										isPurchased													? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT,
																										text: 'IDS_MOUSE_INSTRUCTION_INSTALL_MODULE' } :
										isEventModule 												? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT,
																										text: 'IDS_MOUSE_INSTRUCTION_PURCHASE_MODULE' } :
										isModulePreviewedInTTX										? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT,
																										text: 'IDS_MOUSE_INSTRUCTION_STOP_PREVIEW_MODULE_TTX' } :
										!isStockModule || (isStockModule && isOwned)				? {	unifiedStatus: SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT,
																										text: 'IDS_MOUSE_INSTRUCTION_START_PREVIEW_MODULE_TTX' }
																									: null")
	)

	(macro PULL_TOOLTIP_UB2_STATE)
	(bindcall externalCall 'direct.action' "['makeModuleParams', { moduleId: moduleComponentId }]" init=false watch=false (event "evStartShow"))
	(style (hitTest = false) (width = 320px))

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND_MARKUP)
	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderWithIconAndText
			_imageUrl =			"headerIconPath"
			_imageWidth =		"60"
			_imageHeight =		"60"
			_unifiedStatus =	"unifiedStatus"
			_headerText =		"headerText"
			_subheaderText =	"subheaderText"
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "moduleStateInfo"))
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "moduleStateInfo")
				(args
					_unifiedStatus = "moduleStateInfo.unifiedStatus"
					_text = "moduleStateInfo.text"
				)
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "isResearchPriceVisible"))
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemAlterablePriceTagLine'
				(bind enabled "isResearchPriceVisible")
				(args
					_title = 'IDS_RESEARCH_COST'
					_priceInfo = "moduleExplorePriceInfo"
				)
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "isBuyPriceVisible"))
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemAlterablePriceTagLine'
				(bind enabled "isBuyPriceVisible")
				(args
					_title = 'IDS_PURCHASE_COST'
					_priceInfo = "moduleBuyPriceInfo"
				)
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "extendedInfoComponent != null"))
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemDescriptionText'
				(bind enabled "extendedInfoComponent != null")
				(args
					_descriptionText = "'IDS_' + moduleComponent.name + '_DESCRIPTION'"
				)
			)
		)

		(element TooltipSystemHorizontalDivider)

		(element TooltipSystemDockModuleParameters
			_ttxDescriptor = "ttxDescriptor"
			_extendedInfo = "extendedInfoComponent"
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "mouseInstruction"))
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "mouseInstruction")
				(args
					_unifiedStatus = "mouseInstruction.unifiedStatus"
					_text = "mouseInstruction.text"
				)
			)
		)
	)
)

(def element ModuleTooltipHolder (_modulePK:str, _parentWidth:number, _parentHeight:number, _noMouseInstructions:bool=false, _isShowUB2Tooltip:bool=false) layout=true dispatch_size_change=true
	(style
		(position = "absolute")
		(width = "_parentWidth")
		(height = "_parentHeight")
		(backgroundColor = 0x01000000)
	)

	(controller $Tooltip
		(renderer = 'ModuleTooltip')
		(args
			_modulePK = "_modulePK"
			_noMouseInstructions = "_noMouseInstructions"
			_isShowUB2Tooltip = "_isShowUB2Tooltip"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR "0")
		(offset = { x: 20, y: 20 })
		(align = "right|middle")
	)
)

(def element ModuleEventInfotip (_moduleIds:array, _moduleType:str, _shipId:number, _isInfotip:bool=false, _infotipVisible:bool=true)
	(scope
		(var moduleTypeUpper:str = "toUpper(_moduleType)")
	)
	(style
		(width = 320)
		(backgroundColor = 0x01000000)
	)

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND "true")

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER

		(element TooltipSystemHeaderSubheaderText
			_headerText = "'IDS_MODULES' + moduleTypeUpper"
		)

		(element TooltipSystemHorizontalDivider)

		(element TooltipSystemDescriptionText
			_descriptionText = "'IDS_MODULES_IMPROVING' + moduleTypeUpper"
		)

		(element TooltipSystemHorizontalDivider)

		(block
			(style
				(width = 320)
				(marginLeft = -16)
				(marginRight = -16)
				(marginBottom = -12)
				(marginTop = -12)
			)
			(controller $Repeat renderer='ModuleInfotipItem'
				(bind count "_moduleIds.length")
				(args
					_moduleIds = "_moduleIds"
					_moduleType = "_moduleType"
					_shipId = "_shipId"
					_isInfotip = "_isInfotip"
					_infotipVisible = "_infotipVisible"
				)
			)
		)
	)
	(element InfotipPins "{pinTop: 16, pinBottom: 0, pinLeft: 0, pinRight: 0}" "true")
)

(def element ModuleInfotipItem (_moduleIds:array, _moduleType:str, _shipId:number, _isInfotip:bool, _infotipVisible:bool=true)
	(scope
		(macro MOUSE_HANDLER_SCOPE "'module_'")

		(var moduleEntity:gfx = "$datahub.getPrimaryEntity(CC.module, _moduleIds[$index])")
		(var moduleId:number = "_moduleIds[$index]")
		(var moduleComponent:gfx = "moduleEntity.module")

		(var modulePK:str = "moduleComponent.id" (event "moduleComponent.evUpdated"))

		(var isInstalled:gfx = "moduleComponent.isInstalled" (event "moduleComponent.evUpdated"))
		(var isPurchased:bool = "moduleComponent.isPurchased" (event "moduleComponent.evUpdated"))
		(var isResearched:bool = "moduleComponent.isExplored" (event "moduleComponent.evUpdated"))
		(var totalCost:number = "moduleComponent.totalCostCR" (event "moduleComponent.evUpdated"))
		(var totalCostXP:number = "moduleComponent.totalCostXP" (event "moduleComponent.evUpdated"))

		(var eventShopLinkEntity:gfx = "$datahub.getPrimaryEntity(CC.eventShopItemLink, moduleId)")
		(var eventShopEntity:gfx = "eventShopLinkEntity ? $datahub.getEntity(eventShopLinkEntity.eventShopItemLink.eventShopItemEntityId) : null")
		(var itemPriceEntity:gfx = "eventShopEntity ? $datahub.getEntity(eventShopEntity.eventShopItem.itemPriceIds[0]) : null")

		(var moduleBuyPricesEntity:gfx = "moduleComponent && itemPriceEntity == null ? $datahub.getPrimaryEntity(CC.prices, toString(moduleComponent.id) + '_' + toString(SC.Common.PRICE_ACTION.BUY)) : null")
		(var moduleBuyPricesIds:array = "moduleBuyPricesEntity ? moduleBuyPricesEntity.prices.pricesInCurrencies : null" (event "moduleBuyPricesEntity.prices.evChanged"))
		(var moduleBuyPriceEntity:gfx =	"moduleBuyPricesIds ? $datahub.getEntity(toString(moduleBuyPricesIds[0])) : null")
		(var moduleBuyPriceInfo:gfx = "isResearched ? itemPriceEntity ? itemPriceEntity.itemPrice : moduleBuyPriceEntity ? moduleBuyPriceEntity.itemPrice : {finalPrice: totalCost, currency: SC.Common.CURRENCIES.METASHOPIUM_2} : {finalPrice: totalCostXP, currency: SC.Common.CURRENCIES.XP}" (event "moduleBuyPriceEntity.itemPrice.evChanged"))

		(var isNew:bool = "moduleEntity ? moduleEntity.hasComponent(CC.newItem) : false" (event "moduleEntity.evAdded") (event "moduleEntity.evRemoved"))
		(var iconName:str = "'url:../modules/event/' + _moduleType + '/icon_module_' + moduleComponent.name + (isInstalled ? '_installed' : '') + '.png'")
		(var headerText:str = "moduleComponent ? moduleComponent.nameText : ''" (event "moduleComponent.evUpdated"))

		(var actionType:str =	"	isInstalled ?	'' :
									isPurchased ?	'inputMapping.onAction' :
													'inputMapping.onRequest'")
		
		(var clickAction:str = "isInstalled						? null :
								isPurchased						? 'installModule' :
								isResearched					? 'openPurchaseAndInstallModuleWindow'
																: 'openResearchModuleWindow'")

		(var actionParams:dict = "	clickAction == 'installModule'	?	{shipId: _shipId, moduleId: moduleComponent.id} :
									clickAction != null				?	{modulePK: modulePK}
																			:	null")

		
		(macro INFOTIP_ROW_BACKGROUND_SCOPE
			_isHovered = "_isInfotip && module_rollOver"
			_isPressed = "module_mouseDown && clickAction != null"
			_isSelected = "_isInfotip && isInstalled"
		)
	)

	(bindcall externalCall "actionType" "[clickAction, actionParams]" init=false watch=false on='leftClick')

	(style
		(width = 100%)
		(backgroundColor = 0x01000000)
	)

	(macro SOUND_HANDLER _soundSet = "'button_module'" _prefix = "'module_'")

	(macro MOUSE_EVENTS_DISPATCHER
		_prefix = "'module_'"
	)

	(macro INFOTIP_ROW_BACKGROUND "currentAlpha")

	(controller $Tooltip
		(renderer = 'ModuleTooltip')
		(bind enabled "_isInfotip && modulePK != '' && _infotipVisible")
		(args
			_modulePK = "modulePK"
			_noMouseInstructions = false
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR "0")
		(offset = { x: 20, y: 20 })
		(align = "right|middle")
	)

	(block
		(style
			(position = "absolute")
			(width = 288)
			(top = -12)
			(left = 16)
		)
		(controller $Instance renderer='TooltipSystemHorizontalDivider'
			(bind enabled "$index != 0")
		)
	)

	(block
		(style
			(width = 100%)
			(height = 70)
		)

		(hblock
			(class $FullsizeAbsolute)
			(style
				(align = "middle")
			)
			(block
				(style
					(width = 60)
					(height = 60)

					(marginLeft = "XS")

					(bind backgroundImage "iconName")
					(backgroundSize = "fill")
				)
			)

			(tf
				(class $TextDefaultNM)
				(style
					(marginLeft = "S")
					(maxWidth = 150)
					(height = 80%)
					(bind textColor "isInstalled ? 0xFFCC66 : 0xFFFFFF")
				)
				(bind text "headerText")
			)
			
			(block
				(style (marginTop = "-LS"))

				(block
					(macro DEFAULT_CONTROL_MARKER_ANIMATION "isNew")
					(element MarkerNew)
				)
			)
			(block
				(style
					(width = 100%)
					(height = 80%)
					(align = "right")
					(paddingRight = "S")
				)
				(block
					(bind visible "isInstalled")
					(style
						(width = 20)
						(height = 20)
						(backgroundImage = 'url:../service_kit/unified_status_icons/icon_check.png')
						(backgroundSize = "fill")
					)
				)
				(tf
					(bind visible "!isInstalled && isPurchased")
					(class $TextDefaultNM)
					(style
						(textAlign = "right")
					)
					(text = "'IDS_IN_WAREHOUSE_NO_COLON'")
				)
				(controller $Instance renderer='PriceTag'
					(bind enabled "!isInstalled && !isPurchased")
					(args
						_priceInfo			= "moduleBuyPriceInfo"
						_showDiscountTag	= false
					)
				)
			)
		)
	)
)